.if \n[.g] .mso www.tmac
.TH SDL_AsyncIOOutcome 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_AsyncIOOutcome \- Information about a completed asynchronous I/O request.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_asyncio.h>
.PP
.BI "typedef struct SDL_AsyncIOOutcome
.BI "{
.BI "    SDL_AsyncIO *asyncio;   /**< what generated this task. This pointer will be invalid if it was closed! */
.BI "    SDL_AsyncIOTaskType type;  /**< What sort of task was this? Read, write, etc? */
.BI "    SDL_AsyncIOResult result;  /**< the result of the work (success, failure, cancellation). */
.BI "    void *buffer;  /**< buffer where data was read/written. */
.BI "    Uint64 offset;  /**< offset in the SDL_AsyncIO where data was read/written. */
.BI "    Uint64 bytes_requested;  /**< number of bytes the task was to read/write. */
.BI "    Uint64 bytes_transferred;  /**< actual number of bytes that were read/written. */
.BI "    void *userdata;    /**< pointer provided by the app when starting the task */
.BI "} SDL_AsyncIOOutcome;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

