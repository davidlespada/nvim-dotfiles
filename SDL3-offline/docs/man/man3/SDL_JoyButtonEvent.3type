.if \n[.g] .mso www.tmac
.TH SDL_JoyButtonEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_JoyButtonEvent \- Joystick button event structure (event.jbutton.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_JoyButtonEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_JOYSTICK_BUTTON_DOWN or SDL_EVENT_JOYSTICK_BUTTON_UP */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_JoystickID which; /**< The joystick instance id */
.BI "    Uint8 button;       /**< The joystick button index */
.BI "    bool down;      /**< true if the button is pressed */
.BI "    Uint8 padding1;
.BI "    Uint8 padding2;
.BI "} SDL_JoyButtonEvent;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

