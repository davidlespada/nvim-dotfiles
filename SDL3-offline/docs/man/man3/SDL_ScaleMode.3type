.TH SDL_ScaleMode 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_ScaleMode \- The scaling mode.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_surface.h>
.PP
.BI "typedef enum SDL_ScaleMode
.BI "{
.BI "    SDL_SCALEMODE_INVALID = -1,
.BI "    SDL_SCALEMODE_NEAREST,  /**< nearest pixel sampling */
.BI "    SDL_SCALEMODE_LINEAR,   /**< linear filtering */
.BI "    SDL_SCALEMODE_PIXELART  /**< nearest pixel sampling with improved scaling for pixel art, available since SDL 3.4.0 */
.BI "} SDL_ScaleMode;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]2\[char46]0\[char46]

