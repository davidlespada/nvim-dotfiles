.TH SDL_TextInputEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_TextInputEvent \- Keyboard text input event structure (event.text.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_TextInputEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_TEXT_INPUT */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_WindowID windowID; /**< The window with keyboard focus, if any */
.BI "    const char *text;   /**< The input text, UTF-8 encoded */
.BI "} SDL_TextInputEvent;
.fi
.SH DESCRIPTION
This event will never be delivered unless text input is enabled by calling
.BR SDL_StartTextInput ()\[char46]
Text input is disabled by default!

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_StartTextInput (3),
.BR SDL_StopTextInput (3)
