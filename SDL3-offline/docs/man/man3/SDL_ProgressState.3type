.if \n[.g] .mso www.tmac
.TH SDL_ProgressState 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_ProgressState \- Window progress state
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_video.h>
.PP
.BI "typedef enum SDL_ProgressState
.BI "{
.BI "    SDL_PROGRESS_STATE_INVALID = -1,    /**< An invalid progress state indicating an error; check SDL_GetError() */
.BI "    SDL_PROGRESS_STATE_NONE,            /**< No progress bar is shown */
.BI "    SDL_PROGRESS_STATE_INDETERMINATE,   /**< The progress bar is shown in a indeterminate state */
.BI "    SDL_PROGRESS_STATE_NORMAL,          /**< The progress bar is shown in a normal state */
.BI "    SDL_PROGRESS_STATE_PAUSED,          /**< The progress bar is shown in a paused state */
.BI "    SDL_PROGRESS_STATE_ERROR            /**< The progress bar is shown in a state indicating the application had an error */
.BI "} SDL_ProgressState;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]2\[char46]8\[char46]

