.TH SDL_GamepadDeviceEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GamepadDeviceEvent \- Gamepad device event structure (event.gdevice.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_GamepadDeviceEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_GAMEPAD_ADDED, SDL_EVENT_GAMEPAD_REMOVED, or SDL_EVENT_GAMEPAD_REMAPPED, SDL_EVENT_GAMEPAD_UPDATE_COMPLETE or SDL_EVENT_GAMEPAD_STEAM_HANDLE_UPDATED */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_JoystickID which;       /**< The joystick instance id */
.BI "} SDL_GamepadDeviceEvent;
.fi
.SH DESCRIPTION
Joysticks that are supported gamepads receive both an
.BR SDL_JoyDeviceEvent
and an
.BR SDL_GamepadDeviceEvent \[char46]
.PP
SDL will send GAMEPAD_ADDED events for joysticks that are already plugged in during
.BR SDL_Init ()
and are recognized as gamepads\[char46] It will also send events for joysticks that get gamepad mappings at runtime\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_JoyDeviceEvent (3type)
