.if \n[.g] .mso www.tmac
.TH SDL_FlipMode 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_FlipMode \- The flip mode.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_surface.h>
.PP
.BI "typedef enum SDL_FlipMode
.BI "{
.BI "    SDL_FLIP_NONE,                                                                  /**< Do not flip */
.BI "    SDL_FLIP_HORIZONTAL,                                                            /**< flip horizontally */
.BI "    SDL_FLIP_VERTICAL,                                                              /**< flip vertically */
.BI "    SDL_FLIP_HORIZONTAL_AND_VERTICAL = (SDL_FLIP_HORIZONTAL | SDL_FLIP_VERTICAL)    /**< flip horizontally and vertically (not a diagonal flip) */
.BI "} SDL_FlipMode;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]2\[char46]0\[char46]

