.TH SDL_CameraSpec 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_CameraSpec \- The details of an output format for a camera device.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_camera.h>
.PP
.BI "typedef struct SDL_CameraSpec
.BI "{
.BI "    SDL_PixelFormat format;     /**< Frame format */
.BI "    SDL_Colorspace colorspace;  /**< Frame colorspace */
.BI "    int width;                  /**< Frame width */
.BI "    int height;                 /**< Frame height */
.BI "    int framerate_numerator;     /**< Frame rate numerator ((num / denom) == FPS, (denom / num) == duration in seconds) */
.BI "    int framerate_denominator;   /**< Frame rate denominator ((num / denom) == FPS, (denom / num) == duration in seconds) */
.BI "} SDL_CameraSpec;
.fi
.SH DESCRIPTION
Cameras often support multiple formats; each one will be encapsulated in this struct\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_GetCameraSupportedFormats (3),
.BR SDL_GetCameraFormat (3)
