.TH SDL_Texture 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_Texture \- An efficient driver-specific representation of pixel data
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_render.h>
.PP
.BI "struct SDL_Texture
.BI "{
.BI "    SDL_PixelFormat format;     /**< The format of the texture, read-only */
.BI "    int w;                      /**< The width of the texture, read-only. */
.BI "    int h;                      /**< The height of the texture, read-only. */
.BI "
.BI "    int refcount;               /**< Application reference count, used when freeing texture */
.BI "};
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_CreateTexture (3),
.BR SDL_CreateTextureFromSurface (3),
.BR SDL_CreateTextureWithProperties (3),
.BR SDL_DestroyTexture (3)
