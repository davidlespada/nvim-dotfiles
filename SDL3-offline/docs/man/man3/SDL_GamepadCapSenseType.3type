.TH SDL_GamepadCapSenseType 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GamepadCapSenseType \- The list of capsense types on a gamepad
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gamepad.h>
.PP
.BI "typedef enum SDL_GamepadCapSenseType
.BI "{
.BI "    SDL_GAMEPAD_CAPSENSE_INVALID = -1,
.BI "    SDL_GAMEPAD_CAPSENSE_LEFT_STICK,    /**< Activated by touching the top of the left thumbstick */
.BI "    SDL_GAMEPAD_CAPSENSE_RIGHT_STICK,   /**< Activated by touching the top of the right thumbstick */
.BI "    SDL_GAMEPAD_CAPSENSE_LEFT_GRIP,     /**< Activated by gripping the left handle of the controller */
.BI "    SDL_GAMEPAD_CAPSENSE_RIGHT_GRIP,    /**< Activated by gripping the right handle of the controller */
.BI "    SDL_GAMEPAD_CAPSENSE_COUNT
.BI "} SDL_GamepadCapSenseType;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]6\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_GamepadHasCapSense (3),
.BR SDL_GetGamepadCapSense (3)
