.TH SDL_ClipboardEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_ClipboardEvent \- An event triggered when the clipboard contents have changed (event.clipboard.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_ClipboardEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_CLIPBOARD_UPDATE */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    bool owner;         /**< are we owning the clipboard (internal update) */
.BI "    Sint32 num_mime_types;   /**< number of mime types */
.BI "    const char **mime_types; /**< current mime types */
.BI "} SDL_ClipboardEvent;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

