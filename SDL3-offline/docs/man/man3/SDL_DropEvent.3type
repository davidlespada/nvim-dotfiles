.if \n[.g] .mso www.tmac
.TH SDL_DropEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_DropEvent \- An event used to drop text or request a file open by the system (event.drop.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_DropEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_DROP_BEGIN or SDL_EVENT_DROP_FILE or SDL_EVENT_DROP_TEXT or SDL_EVENT_DROP_COMPLETE or SDL_EVENT_DROP_POSITION */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_WindowID windowID;    /**< The window that was dropped on, if any */
.BI "    float x;            /**< X coordinate, relative to window (not on begin) */
.BI "    float y;            /**< Y coordinate, relative to window (not on begin) */
.BI "    const char *source; /**< The source app that sent this drop event, or NULL if that isn't available */
.BI "    const char *data;   /**< The text for SDL_EVENT_DROP_TEXT and the file name for SDL_EVENT_DROP_FILE, NULL for other events */
.BI "} SDL_DropEvent;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

