.TH SDL_GPUMultisampleState 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUMultisampleState \- A structure specifying the parameters of the graphics pipeline multisample state.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUMultisampleState
.BI "{
.BI "    SDL_GPUSampleCount sample_count;  /**< The number of samples to be used in rasterization. */
.BI "    Uint32 sample_mask;               /**< Reserved for future use. Must be set to 0. */
.BI "    bool enable_mask;                 /**< Reserved for future use. Must be set to false. */
.BI "    bool enable_alpha_to_coverage;    /**< true enables the alpha-to-coverage feature. */
.BI "    Uint8 padding2;
.BI "    Uint8 padding3;
.BI "} SDL_GPUMultisampleState;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_GPUGraphicsPipelineCreateInfo (3type),
.BR SDL_GPUSampleCount (3type)
