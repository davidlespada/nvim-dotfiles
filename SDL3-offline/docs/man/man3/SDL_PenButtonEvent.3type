.TH SDL_PenButtonEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_PenButtonEvent \- Pressure-sensitive pen button event structure (event.pbutton.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_PenButtonEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_PEN_BUTTON_DOWN or SDL_EVENT_PEN_BUTTON_UP */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_WindowID windowID; /**< The window with mouse focus, if any */
.BI "    SDL_PenID which;        /**< The pen instance id */
.BI "    SDL_PenInputFlags pen_state;   /**< Complete pen input state at time of event */
.BI "    float x;                /**< X coordinate, relative to window */
.BI "    float y;                /**< Y coordinate, relative to window */
.BI "    Uint8 button;       /**< The pen button index (first button is 1). */
.BI "    bool down;      /**< true if the button is pressed */
.BI "    SDL_PenDeviceType device_type; /**< the device type of the pen, if known (added in 3.4.18). */
.BI "} SDL_PenButtonEvent;
.fi
.SH DESCRIPTION
This is for buttons on the pen itself that the user might click\[char46] The pen itself pressing down to draw triggers a
.BR SDL_EVENT_PEN_DOWN
event instead\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

