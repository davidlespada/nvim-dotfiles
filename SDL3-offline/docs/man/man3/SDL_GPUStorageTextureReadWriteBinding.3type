.TH SDL_GPUStorageTextureReadWriteBinding 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUStorageTextureReadWriteBinding \- A structure specifying parameters related to binding textures in a compute pass.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUStorageTextureReadWriteBinding
.BI "{
.BI "    SDL_GPUTexture *texture;  /**< The texture to bind. Must have been created with SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_WRITE or SDL_GPU_TEXTUREUSAGE_COMPUTE_STORAGE_SIMULTANEOUS_READ_WRITE. */
.BI "    Uint32 mip_level;         /**< The mip level index to bind. */
.BI "    Uint32 layer;             /**< The layer index to bind. */
.BI "    bool cycle;               /**< true cycles the texture if it is already bound. */
.BI "    Uint8 padding1;
.BI "    Uint8 padding2;
.BI "    Uint8 padding3;
.BI "} SDL_GPUStorageTextureReadWriteBinding;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_BeginGPUComputePass (3)
