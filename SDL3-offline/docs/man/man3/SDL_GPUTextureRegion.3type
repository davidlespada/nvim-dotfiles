.TH SDL_GPUTextureRegion 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUTextureRegion \- A structure specifying a region of a texture.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUTextureRegion
.BI "{
.BI "    SDL_GPUTexture *texture;  /**< The texture used in the copy operation. */
.BI "    Uint32 mip_level;         /**< The mip level index to transfer. */
.BI "    Uint32 layer;             /**< The layer index to transfer. */
.BI "    Uint32 x;                 /**< The left offset of the region. */
.BI "    Uint32 y;                 /**< The top offset of the region. */
.BI "    Uint32 z;                 /**< The front offset of the region. */
.BI "    Uint32 w;                 /**< The width of the region. */
.BI "    Uint32 h;                 /**< The height of the region. */
.BI "    Uint32 d;                 /**< The depth of the region. */
.BI "} SDL_GPUTextureRegion;
.fi
.SH DESCRIPTION
Used when transferring data to or from a texture\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_UploadToGPUTexture (3),
.BR SDL_DownloadFromGPUTexture (3),
.BR SDL_CreateGPUTexture (3),
.BR SDL_GPUTexture (3type)
