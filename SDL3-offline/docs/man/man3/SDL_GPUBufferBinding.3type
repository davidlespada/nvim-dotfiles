.TH SDL_GPUBufferBinding 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUBufferBinding \- A structure specifying parameters in a buffer binding call.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUBufferBinding
.BI "{
.BI "    SDL_GPUBuffer *buffer;  /**< The buffer to bind. Must have been created with SDL_GPU_BUFFERUSAGE_VERTEX for SDL_BindGPUVertexBuffers, or SDL_GPU_BUFFERUSAGE_INDEX for SDL_BindGPUIndexBuffer. */
.BI "    Uint32 offset;          /**< The starting byte of the data to bind in the buffer. */
.BI "} SDL_GPUBufferBinding;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_BindGPUVertexBuffers (3),
.BR SDL_BindGPUIndexBuffer (3)
