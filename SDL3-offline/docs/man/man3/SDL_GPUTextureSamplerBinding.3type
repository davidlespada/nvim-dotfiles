.TH SDL_GPUTextureSamplerBinding 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUTextureSamplerBinding \- A structure specifying parameters in a sampler binding call.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUTextureSamplerBinding
.BI "{
.BI "    SDL_GPUTexture *texture;  /**< The texture to bind. Must have been created with SDL_GPU_TEXTUREUSAGE_SAMPLER. */
.BI "    SDL_GPUSampler *sampler;  /**< The sampler to bind. */
.BI "} SDL_GPUTextureSamplerBinding;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_BindGPUVertexSamplers (3),
.BR SDL_BindGPUFragmentSamplers (3),
