.TH SDL_NotificationEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_NotificationEvent \- Notification dialog event structure (event.notification.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_NotificationEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_NOTIFICATION_ACTION_INVOKED */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;         /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_NotificationID which; /**< The ID of the notification that generated this event. */
.BI "    const char *action_id;    /**< The identifier string of the action invoked in the notification dialog. */
.BI "} SDL_NotificationEvent;
.fi
.SH DESCRIPTION
An
.BR action_id
value of \(aqdefault\(aq for an
.BR SDL_EVENT_NOTIFICATION_ACTION_INVOKED
event indicates that the notification was interacted with without selecting a specific action (e\[char46]g\[char46] the body of the notification was clicked on)\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]6\[char46]0\[char46]

