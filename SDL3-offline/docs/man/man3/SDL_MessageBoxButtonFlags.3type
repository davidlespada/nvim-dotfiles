.TH SDL_MessageBoxButtonFlags 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_MessageBoxButtonFlags \- 
.BR SDL_MessageBoxButtonData
flags.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_messagebox.h>
.PP
.BI "typedef Uint32 SDL_MessageBoxButtonFlags;
.BI "
.BI "#define SDL_MESSAGEBOX_BUTTON_RETURNKEY_DEFAULT 0x00000001u /**< Marks the default button when return is hit */
.BI "#define SDL_MESSAGEBOX_BUTTON_ESCAPEKEY_DEFAULT 0x00000002u /**< Marks the default button when escape is hit */
.fi
