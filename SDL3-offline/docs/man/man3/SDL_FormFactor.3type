.TH SDL_FormFactor 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_FormFactor \- The possible form factors for a device.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_system.h>
.PP
.BI "typedef enum SDL_FormFactor {
.BI "    SDL_FORMFACTOR_UNKNOWN = 0,
.BI "    SDL_FORMFACTOR_DESKTOP,
.BI "    SDL_FORMFACTOR_LAPTOP,
.BI "    SDL_FORMFACTOR_PHONE,
.BI "    SDL_FORMFACTOR_TABLET,
.BI "    SDL_FORMFACTOR_CONSOLE,
.BI "    SDL_FORMFACTOR_HANDHELD,
.BI "    SDL_FORMFACTOR_WATCH,
.BI "    SDL_FORMFACTOR_TV,
.BI "    SDL_FORMFACTOR_HEADSET,
.BI "    SDL_FORMFACTOR_CAR
.BI "} SDL_FormFactor;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]4\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_GetDeviceFormFactor (3),
.BR SDL_GetDeviceFormFactorName (3)
