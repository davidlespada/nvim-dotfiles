.TH SDL_GPURenderStateCreateInfo 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPURenderStateCreateInfo \- A structure specifying the parameters of a GPU render state.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_render.h>
.PP
.BI "typedef struct SDL_GPURenderStateCreateInfo
.BI "{
.BI "    SDL_GPUShader *fragment_shader; /**< The fragment shader to use when this render state is active */
.BI "
.BI "    Sint32 num_sampler_bindings;    /**< The number of additional fragment samplers to bind when this render state is active */
.BI "    const SDL_GPUTextureSamplerBinding *sampler_bindings;   /**< Additional fragment samplers to bind when this render state is active */
.BI "
.BI "    Sint32 num_storage_textures;    /**< The number of storage textures to bind when this render state is active */
.BI "    SDL_GPUTexture *const *storage_textures;    /**< Storage textures to bind when this render state is active */
.BI "
.BI "    Sint32 num_storage_buffers;     /**< The number of storage buffers to bind when this render state is active */
.BI "    SDL_GPUBuffer *const *storage_buffers;      /**< Storage buffers to bind when this render state is active */
.BI "
.BI "    SDL_PropertiesID props;         /**< A properties ID for extensions. Should be 0 if no extensions are needed. */
.BI "} SDL_GPURenderStateCreateInfo;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]4\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_CreateGPURenderState (3)
