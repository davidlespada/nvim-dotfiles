.if \n[.g] .mso www.tmac
.TH SDL_PenInputFlags 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_PenInputFlags \- Pen input flags, as reported by various pen events\(aq
.BR pen_state
field.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_pen.h>
.PP
.BI "typedef Uint32 SDL_PenInputFlags;
.BI "
.BI "#define SDL_PEN_INPUT_DOWN         (1u << 0)  /**< pen is pressed down */
.BI "#define SDL_PEN_INPUT_BUTTON_1     (1u << 1)  /**< button 1 is pressed */
.BI "#define SDL_PEN_INPUT_BUTTON_2     (1u << 2)  /**< button 2 is pressed */
.BI "#define SDL_PEN_INPUT_BUTTON_3     (1u << 3)  /**< button 3 is pressed */
.BI "#define SDL_PEN_INPUT_BUTTON_4     (1u << 4)  /**< button 4 is pressed */
.BI "#define SDL_PEN_INPUT_BUTTON_5     (1u << 5)  /**< button 5 is pressed */
.BI "#define SDL_PEN_INPUT_ERASER_TIP   (1u << 30) /**< eraser tip is used */
.BI "#define SDL_PEN_INPUT_IN_PROXIMITY (1u << 31) /**< pen is in proximity (since SDL 3.4.0) */
.fi
.SH AVAILABILITY
This datatype is available since SDL 3\[char46]2\[char46]0\[char46]

