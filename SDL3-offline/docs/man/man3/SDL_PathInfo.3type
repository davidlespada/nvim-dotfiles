.TH SDL_PathInfo 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_PathInfo \- Information about a path on the filesystem.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_filesystem.h>
.PP
.BI "typedef struct SDL_PathInfo
.BI "{
.BI "    SDL_PathType type;      /**< the path type */
.BI "    Uint64 size;            /**< the file size in bytes */
.BI "    SDL_Time create_time;   /**< the time when the path was created */
.BI "    SDL_Time modify_time;   /**< the last time the path was modified */
.BI "    SDL_Time access_time;   /**< the last time the path was read */
.BI "} SDL_PathInfo;
.fi
.SH AVAILABILITY
This datatype is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_PathType (3type),
.BR SDL_GetPathInfo (3),
.BR SDL_GetStoragePathInfo (3)
