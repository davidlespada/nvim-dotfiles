.TH SDL_TextEditingEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_TextEditingEvent \- Keyboard text editing event structure (event.edit.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_TextEditingEvent
.BI "{
.BI "    SDL_EventType type;         /**< SDL_EVENT_TEXT_EDITING */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;           /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_WindowID windowID;      /**< The window with keyboard focus, if any */
.BI "    const char *text;           /**< The editing text */
.BI "    Sint32 start;               /**< The start cursor of selected editing text, or -1 if not set */
.BI "    Sint32 length;              /**< The length of selected editing text, or -1 if not set */
.BI "} SDL_TextEditingEvent;
.fi
.SH DESCRIPTION
The start cursor is the position, in UTF-8 characters, where new typing will be inserted into the editing text\[char46] The length is the number of UTF-8 characters that will be replaced by new typing\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

