.TH SDL_GPUStencilOpState 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUStencilOpState \- A structure specifying the stencil operation state of a graphics pipeline.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUStencilOpState
.BI "{
.BI "    SDL_GPUStencilOp fail_op;        /**< The action performed on samples that fail the stencil test. */
.BI "    SDL_GPUStencilOp pass_op;        /**< The action performed on samples that pass the depth and stencil tests. */
.BI "    SDL_GPUStencilOp depth_fail_op;  /**< The action performed on samples that pass the stencil test and fail the depth test. */
.BI "    SDL_GPUCompareOp compare_op;     /**< The comparison operator used in the stencil test. */
.BI "} SDL_GPUStencilOpState;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_GPUDepthStencilState (3type),
