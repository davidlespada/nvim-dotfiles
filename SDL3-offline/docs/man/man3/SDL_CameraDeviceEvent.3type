.TH SDL_CameraDeviceEvent 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_CameraDeviceEvent \- Camera device event structure (event.cdevice.*)
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_events.h>
.PP
.BI "typedef struct SDL_CameraDeviceEvent
.BI "{
.BI "    SDL_EventType type; /**< SDL_EVENT_CAMERA_DEVICE_ADDED, SDL_EVENT_CAMERA_DEVICE_REMOVED, SDL_EVENT_CAMERA_DEVICE_APPROVED, SDL_EVENT_CAMERA_DEVICE_DENIED */
.BI "    Uint32 reserved;
.BI "    Uint64 timestamp;   /**< In nanoseconds, populated using SDL_GetTicksNS() */
.BI "    SDL_CameraID which;       /**< SDL_CameraID for the device being added or removed or changing */
.BI "} SDL_CameraDeviceEvent;
.fi
.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

