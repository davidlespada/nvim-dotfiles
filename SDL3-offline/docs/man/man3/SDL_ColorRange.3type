.if \n[.g] .mso www.tmac
.TH SDL_ColorRange 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_ColorRange \- Colorspace color range, as described by https://www.itu.int/rec/R-REC-BT.2100-2-201807-I/en
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_pixels.h>
.PP
.BI "typedef enum SDL_ColorRange
.BI "{
.BI "    SDL_COLOR_RANGE_UNKNOWN = 0,
.BI "    SDL_COLOR_RANGE_LIMITED = 1, /**< Narrow range, e.g. 16-235 for 8-bit RGB and luma, and 16-240 for 8-bit chroma */
.BI "    SDL_COLOR_RANGE_FULL = 2    /**< Full range, e.g. 0-255 for 8-bit RGB and luma, and 1-255 for 8-bit chroma */
.BI "} SDL_ColorRange;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]2\[char46]0\[char46]

