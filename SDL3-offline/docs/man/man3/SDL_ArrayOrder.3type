.TH SDL_ArrayOrder 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_ArrayOrder \- Array component order, low byte -> high byte.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_pixels.h>
.PP
.BI "typedef enum SDL_ArrayOrder
.BI "{
.BI "    SDL_ARRAYORDER_NONE,
.BI "    SDL_ARRAYORDER_RGB,
.BI "    SDL_ARRAYORDER_RGBA,
.BI "    SDL_ARRAYORDER_ARGB,
.BI "    SDL_ARRAYORDER_BGR,
.BI "    SDL_ARRAYORDER_BGRA,
.BI "    SDL_ARRAYORDER_ABGR
.BI "} SDL_ArrayOrder;
.fi
.SH AVAILABILITY
This enum is available since SDL 3\[char46]2\[char46]0\[char46]

