.TH SDL_GPUVertexAttribute 3type "SDL 3.5.0" "Simple Directmedia Layer" "SDL3 DATATYPES"
.SH NAME
SDL_GPUVertexAttribute \- A structure specifying a vertex attribute.
.SH SYNOPSIS
.nf
.B #include <SDL3/SDL_gpu.h>
.PP
.BI "typedef struct SDL_GPUVertexAttribute
.BI "{
.BI "    Uint32 location;                    /**< The shader input location index. */
.BI "    Uint32 buffer_slot;                 /**< The binding slot of the associated vertex buffer. */
.BI "    SDL_GPUVertexElementFormat format;  /**< The size and type of the attribute data. */
.BI "    Uint32 offset;                      /**< The byte offset of this attribute relative to the start of the vertex element. */
.BI "} SDL_GPUVertexAttribute;
.fi
.SH DESCRIPTION
All vertex attribute locations provided to an
.BR SDL_GPUVertexInputState
must be unique\[char46]

.SH AVAILABILITY
This struct is available since SDL 3\[char46]2\[char46]0\[char46]

.SH SEE ALSO
.BR SDL_GPUVertexBufferDescription (3type),
.BR SDL_GPUVertexInputState (3type),
.BR SDL_GPUVertexElementFormat (3type)
